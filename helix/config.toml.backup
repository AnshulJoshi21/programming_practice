# --- THEME ---
theme = "catppuccin_mocha"

[editor]
line-number = "relative"
cursorline = true
scrolloff = 5
color-modes = true               # Vital: changes cursor color by mode
idle-timeout = 100               # Makes auto-complete feel snappier
completion-trigger-len = 2       # Show suggestions after 2 characters
bufferline = "multiple"          # Show open tabs at the top
true-color = true                # Ensures best color fidelity

[editor.cursor-shape]
insert = "bar"
normal = "block"
select = "underline"

[editor.indent-guides]
render = true
character = "┊"                  # Subtle vertical lines
skip-levels = 1

[editor.soft-wrap]
enable = true

[editor.file-picker]
hidden = false                   # Show .gitignore / hidden files
git-ignore = true

[editor.statusline]
left = ["mode", "spinner", "file-name", "read-only-indicator", "file-modification-indicator"]
center = []
right = ["diagnostics", "selections", "position", "file-encoding", "file-type"]
separator = "│"
mode.normal = "NORMAL"
mode.insert = "INSERT"
mode.select = "SELECT"

[editor.lsp]
display-messages = true          # Shows "LSP initializing" etc.
display-inlay-hints = true       # Shows variable types inline (if LSP supports it)

# --- KEYBINDINGS ---

[keys.normal]
# Quick buffer switching (Alt + arrow keys)
"A-right" = ":buffer-next"
"A-left" = ":buffer-previous"
"A-w" = ":buffer-close"

# Collapse selections to single cursors
"esc" = ["collapse_selection", "keep_primary_selection"]

[keys.insert]
# Quickly exit insert mode
"j" = { "k" = "normal_mode" } 

[keys.select]
# Stay in select mode after indenting
"tab" = ["indent", "keep_primary_selection"]
"S-tab" = ["unindent", "keep_primary_selection"]
"j" = { "k" = "normal_mode" } 
